@model IEnumerable<TheImperialHoloweb.Models.Military.ArmoryItemViewModel>
@{
    ViewData["Title"] = "Imperial Armory";
    var typeFilters = new[] { "All", "Firearm", "Vehicle", "Melee", "Explosive" };
}

<div id="header-section">
    <h1 class="imp-header">Imperial Armory</h1>
    <p class="imp-header-text">Weapons &amp; Vessels of the Galaxy &mdash; Imperial and Otherwise</p>
</div>

<div class="armory-container">

    <div class="armory-search-row">
        <input type="text"
               id="armory-search"
               class="armory-search-input"
               placeholder="Search by name or description&hellip;" />
    </div>

    <div class="armory-filter-row">
        @foreach (var type in typeFilters)
        {
            <label class="armory-filter-label">
                <input type="checkbox"
                       class="armory-filter-cb"
                       value="@type"
                       @(type == "All" ? "checked" : "") />
                <span>@type</span>
            </label>
        }
    </div>

    <div class="armory-table-wrap">
        <table class="armory-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Faction</th>
                    <th>Synopsis</th>
                </tr>
            </thead>
            <tbody id="armory-tbody">
                @foreach (var item in Model)
                {
                    <tr class="armory-row"
                        data-name="@item.Name"
                        data-type="@item.Type"
                        data-faction="@item.Faction"
                        data-synopsis="@item.Synopsis"
                        data-description="@item.Description"
                        data-image="@(item.ImagePath ?? "")">
                        <td class="armory-td-name">@item.Name</td>
                        <td>@item.Type</td>
                        <td>@item.Faction</td>
                        <td class="armory-td-synopsis">@item.Synopsis</td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="armory-no-results" class="armory-no-results" style="display:none;">
            No entries match your search.
        </div>
    </div>

</div>

@* ── Modal ── *@
<div id="armory-modal-overlay" class="armory-modal-overlay" style="display:none;" aria-modal="true" role="dialog">
    <div class="armory-modal">
        <div class="armory-modal-header">
            <span id="modal-name" class="armory-modal-name"></span>
            <button id="modal-close-x" class="armory-modal-x" aria-label="Close">&times;</button>
        </div>
        <div class="armory-modal-body">
            <div class="armory-modal-img-placeholder">
                <div class="armory-modal-img-inner">
                    <span class="armory-modal-img-tag">Image Pending &mdash; Classification Review</span>
                    <span id="modal-img-label" class="armory-modal-img-label"></span>
                </div>
            </div>
            <div class="armory-modal-details">
                <div class="armory-modal-meta">
                    <span class="armory-modal-meta-label">Type</span>
                    <span id="modal-type" class="armory-modal-meta-value"></span>
                    <span class="armory-modal-meta-label">Faction</span>
                    <span id="modal-faction" class="armory-modal-meta-value"></span>
                </div>
                <p id="modal-description" class="armory-modal-desc"></p>
            </div>
        </div>
        <div class="armory-modal-footer">
            <button id="modal-close-btn" class="button armory-modal-close-btn">Close</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var searchInput  = document.getElementById('armory-search');
    var filterCbs    = Array.from(document.querySelectorAll('.armory-filter-cb'));
    var rows         = Array.from(document.querySelectorAll('.armory-row'));
    var noResults    = document.getElementById('armory-no-results');
    var overlay      = document.getElementById('armory-modal-overlay');

    function getActiveType() {
        for (var i = 0; i < filterCbs.length; i++) {
            if (filterCbs[i].checked) return filterCbs[i].value;
        }
        return 'All';
    }

    function applyFilters() {
        var text       = searchInput.value.toLowerCase().trim();
        var activeType = getActiveType();
        var visible    = 0;

        rows.forEach(function (row) {
            var nameMatch     = row.dataset.name.toLowerCase().includes(text);
            var synopsisMatch = row.dataset.synopsis.toLowerCase().includes(text);
            var typeMatch     = activeType === 'All' || row.dataset.type === activeType;

            var show = (text === '' || nameMatch || synopsisMatch) && typeMatch;
            row.style.display = show ? '' : 'none';
            if (show) visible++;
        });

        noResults.style.display = visible === 0 ? 'block' : 'none';
    }

    // Search
    searchInput.addEventListener('input', applyFilters);

    // Type filter — enforce single selection; re-check All if nothing selected
    filterCbs.forEach(function (cb) {
        cb.addEventListener('change', function () {
            filterCbs.forEach(function (other) { if (other !== cb) other.checked = false; });
            if (!cb.checked) {
                var allCb = filterCbs.find(function (c) { return c.value === 'All'; });
                if (allCb) allCb.checked = true;
            }
            applyFilters();
        });
    });

    // Modal open
    rows.forEach(function (row) {
        row.addEventListener('click', function () {
            document.getElementById('modal-name').textContent       = row.dataset.name;
            document.getElementById('modal-type').textContent       = row.dataset.type;
            document.getElementById('modal-faction').textContent    = row.dataset.faction;
            document.getElementById('modal-description').textContent = row.dataset.description;
            document.getElementById('modal-img-label').textContent  = row.dataset.name;
            overlay.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        });
    });

    // Modal close
    function closeModal() {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
    }

    document.getElementById('modal-close-x').addEventListener('click', closeModal);
    document.getElementById('modal-close-btn').addEventListener('click', closeModal);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
})();
</script>
}
